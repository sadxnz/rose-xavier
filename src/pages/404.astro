---
import Base from '../layouts/Base.astro';
import Rodape from '../components/Rodape.astro';
---

<Base titulo="Página não encontrada" descricao="Esta página não existe no site da Rose Xavier, enfermeira em Fortaleza.">
  <main class="erro">
    <h1>Esta página não existe.</h1>
    <p>O endereço pode ter mudado. O site da Rose está todo numa página só.</p>
    <a class="botao" href="/">Voltar para o site</a>
  </main>
  <Rodape />
</Base>

<style>
  .erro {
    width: min(100% - 2 * var(--margem), 680px);
    margin-inline: auto;
    padding-block: 96px 120px;
  }
  h1 {
    font-size: var(--t-h2);
    line-height: 1.05;
  }
  p { margin-top: 16px; max-width: 40ch; }
  .botao { margin-top: 32px; }
</style>
