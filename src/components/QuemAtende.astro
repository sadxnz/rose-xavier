---
import { Picture } from 'astro:assets';
import jaleco from '../assets/fotos/rose-jaleco-espelho.jpg';
import { apresentacao, credenciais } from '../data/conteudo';
import { marcar } from '../data/pendente';
---

<section id="quem-atende" class="secao fundo-pedra" aria-labelledby="quem-titulo">
  <div class="wrap grade">
    <h2 id="quem-titulo">Quem vai te atender</h2>
    <div class="foto seixo">
      <Picture
        src={jaleco}
        formats={['avif', 'webp']}
        widths={[320, 480, 640, 800, 975]}
        sizes="(min-width: 960px) 420px, min(320px, 84vw)"
        alt="Rose Xavier de jaleco branco acinturado, fazendo uma foto no espelho do consultório."
      />
    </div>
    <div class="texto">
      <p class="fala">{apresentacao}</p>
      <dl>
        {
          credenciais.map((c) => (
            <div>
              <dt>{c.rotulo}</dt>
              <dd set:html={marcar(c.valor)} />
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .grade {
    display: grid;
    gap: 32px;
  }
  .foto {
    width: min(320px, 84vw);
    aspect-ratio: 975 / 1254;
    justify-self: center;
  }
  .fala {
    max-width: 34ch;
    font-size: var(--t-lead);
    line-height: 1.5;
  }
  dl { margin-top: 32px; }
  dl div {
    padding-block: 14px;
    border-top: 1px solid var(--veio);
  }
  dt {
    font-size: var(--t-peq);
    font-weight: 500;
    color: var(--gaveta-2);
  }
  dd { margin-top: 2px; }

  @media (min-width: 960px) {
    .grade {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
      row-gap: 40px;
      align-items: start;
    }
    .foto {
      grid-column: 1 / 6;
      grid-row: 1 / 3;
      width: 100%;
      max-width: 420px;
      justify-self: start;
    }
    h2 { grid-column: 7 / 13; grid-row: 1; align-self: end; }
    .texto { grid-column: 7 / 13; grid-row: 2; }
    dl {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 32px;
      margin-top: 40px;
    }
  }
</style>
