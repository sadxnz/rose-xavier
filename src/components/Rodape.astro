---
import { site, linkInstagram, linkWhatsApp, mensagemPadrao } from '../data/site';
---

<footer class="rodape escuro">
  <div class="wrap">
    <div class="grade">
      <div>
        <p class="nome">{site.nome}</p>
        <p>{site.profissao}</p>
        <p>{site.coren}</p>
      </div>
      <div>
        <p>{site.local}</p>
        {site.endereco && <p>{site.endereco}</p>}
        <p>{site.cidade}, {site.uf}</p>
      </div>
      <ul role="list">
        <li><a href={linkInstagram} target="_blank" rel="noopener">Instagram @{site.instagram}</a></li>
        <li><a href={linkWhatsApp(mensagemPadrao)} target="_blank" rel="noopener">WhatsApp {site.whatsappExibicao}</a></li>
      </ul>
    </div>
    <div class="legal">
      <p>Resultados variam de pessoa para pessoa; todo procedimento depende de avaliação presencial.</p>
      <a href="/privacidade/">Política de privacidade</a>
    </div>
  </div>
</footer>

<style>
  .rodape {
    padding-block: 56px calc(40px + env(safe-area-inset-bottom));
    font-size: var(--t-peq);
  }
  .grade {
    display: grid;
    gap: 28px;
    padding-top: 40px;
    border-top: 1px solid var(--latao);
  }
  .nome {
    margin-bottom: 4px;
    color: var(--branco);
    font: 500 1.5rem / 1.2 var(--serif);
  }
  ul {
    padding: 0;
    list-style: none;
  }
  li a, .legal a {
    display: inline-block;
    padding-block: 6px;
  }
  .legal {
    display: grid;
    gap: 12px;
    margin-top: 40px;
  }
  .legal p { max-width: 52ch; }

  @media (min-width: 960px) {
    .grade { grid-template-columns: 4fr 4fr 4fr; column-gap: 24px; }
    .legal {
      grid-template-columns: 8fr 4fr;
      column-gap: 24px;
      align-items: baseline;
    }
  }
</style>
