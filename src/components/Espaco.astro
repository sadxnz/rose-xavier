---
import { Picture } from 'astro:assets';
import bandeja from '../assets/fotos/bandeja-2.jpg';
import { site, linkMaps } from '../data/site';
---

<section id="espaco" class="secao" aria-labelledby="espaco-titulo">
  <div class="coluna">
    <h2 id="espaco-titulo">Onde eu atendo</h2>
    <div class="foto seixo seixo--deitado">
      <Picture
        src={bandeja}
        formats={['avif', 'webp']}
        widths={[400, 600, 800, 1200, 1600]}
        sizes="(min-width: 860px) 760px, calc(100vw - 2 * var(--margem))"
        alt="Bandeja espelhada com seringas lacradas e o espelho de mão perolado com o nome Rose Xavier em dourado, sobre a bancada de pedra do consultório."
      />
    </div>
    <div class="info">
      <p class="local">{site.local}, em {site.cidade}.</p>
      <div>
        <h3 class="rotulo">Endereço</h3>
        {
          site.endereco ? (
            <>
              <p>{site.endereco}</p>
              <a href={linkMaps(site.endereco)} target="_blank" rel="noopener">Abrir no Google Maps</a>
            </>
          ) : (
            <p>O endereço completo vai junto com a confirmação do horário.</p>
          )
        }
      </div>
      <div>
        <h3 class="rotulo">Horários</h3>
        <p>{site.horarios}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .coluna {
    width: min(100% - 2 * var(--margem), 760px);
    margin-inline: auto;
  }
  .foto {
    margin-top: 40px;
    width: 100%;
    aspect-ratio: 1603 / 1002;
  }
  .info {
    display: grid;
    gap: 24px;
    margin-top: 40px;
  }
  .local { font: 500 var(--t-h3) / 1.15 var(--serif); }
  .rotulo {
    font: 500 var(--t-peq) / 1.4 var(--sans);
    color: var(--gaveta-2);
  }
  .info p:not(.local) { margin-top: 4px; max-width: 34ch; }
  .info a { display: inline-block; margin-top: 8px; padding-block: 6px; }

  @media (min-width: 960px) {
    .foto { margin-top: 48px; }
    .info {
      grid-template-columns: 1fr 1fr;
      column-gap: 24px;
      margin-top: 48px;
    }
    .local { grid-column: 1 / -1; }
  }
</style>
